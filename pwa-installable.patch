diff --git a/src/components/ServiceWorkerRegister.tsx b/src/components/ServiceWorkerRegister.tsx
new file mode 100644
index 0000000..1333360
--- /dev/null
+++ b/src/components/ServiceWorkerRegister.tsx
@@ -0,0 +1,16 @@
+"use client";
+
+import { useEffect } from "react";
+
+export default function ServiceWorkerRegister() {
+  useEffect(() => {
+    if ("serviceWorker" in navigator) {
+      navigator.serviceWorker.register("/sw.js").catch(() => {
+        // Registration failing (e.g. unsupported browser, dev sandbox) is
+        // non-fatal — the site works fine without offline support.
+      });
+    }
+  }, []);
+
+  return null;
+}
