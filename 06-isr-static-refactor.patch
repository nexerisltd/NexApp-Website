diff --git a/src/components/FavoritableAppGrid.tsx b/src/components/FavoritableAppGrid.tsx
new file mode 100644
index 0000000..73b2aa0
--- /dev/null
+++ b/src/components/FavoritableAppGrid.tsx
@@ -0,0 +1,49 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { createClient } from "@/lib/supabase/client";
+import AppCard from "@/components/AppCard";
+import AnimatedGrid from "@/components/AnimatedGrid";
+import type { App } from "@/lib/types";
+
+export default function FavoritableAppGrid({ apps }: { apps: App[] }) {
+  const [userId, setUserId] = useState<string | null>(null);
+  const [favoritedIds, setFavoritedIds] = useState<Set<string>>(new Set());
+
+  useEffect(() => {
+    let mounted = true;
+    const supabase = createClient();
+
+    supabase.auth.getUser().then(async ({ data }) => {
+      if (!mounted || !data.user) return;
+      setUserId(data.user.id);
+
+      // One query for every card on the page, not one per card.
+      const { data: favs } = await supabase
+        .from("favorites")
+        .select("app_id")
+        .eq("user_id", data.user.id);
+
+      if (mounted && favs) {
+        setFavoritedIds(new Set(favs.map((f) => f.app_id)));
+      }
+    });
+
+    return () => {
+      mounted = false;
+    };
+  }, []);
+
+  return (
+    <AnimatedGrid className="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
+      {apps.map((app) => (
+        <AppCard
+          key={app.id}
+          app={app}
+          userId={userId}
+          initialFavorited={favoritedIds.has(app.id)}
+        />
+      ))}
+    </AnimatedGrid>
+  );
+}
