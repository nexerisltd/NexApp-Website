+  await uploadWithProgress({
+    bucket: PRIVATE_DOC_BUCKET,
+    path,
+    file,
+    accessToken: session.access_token,
+    supabaseUrl: process.env.NEXT_PUBLIC_SUPABASE_URL!,
+    onProgress: opts.onProgress ?? (() => {}),
+  });
