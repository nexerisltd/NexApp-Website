diff --git a/supabase/migrations/0001_videos_sort_order_download_url.sql b/supabase/migrations/0001_videos_sort_order_download_url.sql
new file mode 100644
index 0000000..be497db
--- /dev/null
+++ b/supabase/migrations/0001_videos_sort_order_download_url.sql
@@ -0,0 +1,17 @@
+-- Existing databases: `schema.sql` uses `create table if not exists`, so
+-- re-running it after a column was added to an already-created table does
+-- NOT add the new column. sort_order and download_url were added to
+-- public.videos after some projects had already run the earlier version
+-- of schema.sql, causing inserts from the admin "Add class" form to fail
+-- with a Postgres "column does not exist" error (surfaced to the admin
+-- panel as the generic "Could not create video."). Run this file (once)
+-- against any existing project to bring it in sync with the current
+-- schema.sql. Safe to run multiple times.
+
+alter table public.videos
+  add column if not exists sort_order integer not null default 0;
+
+alter table public.videos
+  add column if not exists download_url text;
+
+create index if not exists idx_videos_board_sort on public.videos (board_id, sort_order);
