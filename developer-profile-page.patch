+++ b/src/app/developers/[id]/page.tsx
@@ -0,0 +1,94 @@
+import { notFound } from "next/navigation";
+import Image from "next/image";
+import { LayoutGrid } from "lucide-react";
+import { createPublicClient } from "@/lib/supabase/public";
+import AppCard from "@/components/AppCard";
+import AnimatedGrid from "@/components/AnimatedGrid";
+import type { App } from "@/lib/types";
+
+type DeveloperProfile = {
+  id: string;
+  full_name: string | null;
+  avatar_url: string | null;
+  created_at: string;
+};
+
+export default async function DeveloperProfilePage({
+  params,
+}: {
+  params: Promise<{ id: string }>;
+}) {
+  const { id } = await params;
+  const supabase = createPublicClient();
+
+  const [{ data: profile }, { data: apps }] = await Promise.all([
+    supabase.from("profiles").select("id, full_name, avatar_url, created_at").eq("id", id).maybeSingle(),
+    supabase
+      .from("apps")
+      .select("*, categories(id, name, slug)")
+      .eq("created_by", id)
+      .eq("status", "published")
+      .order("downloads_count", { ascending: false }),
+  ]);
+
+  // RLS only exposes a profile once that user has a published app, so if
+  // there's no profile row visible here, either the id doesn't exist or
+  // they haven't published anything — either way, nothing to show.
+  if (!profile) notFound();
+
+  const typedProfile = profile as DeveloperProfile;
+  const totalDownloads = (apps as App[] | null)?.reduce(
+    (sum, app) => sum + app.downloads_count,
+    0
+  ) ?? 0;
+
+  const memberSince = new Date(typedProfile.created_at).toLocaleDateString(undefined, {
+    year: "numeric",
+    month: "short",
+  });
+
+  return (
+    <div className="mx-auto max-w-6xl px-6 py-14">
+      <div className="flex items-center gap-5">
+        <div className="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface-2 text-text-muted">
+          {typedProfile.avatar_url ? (
+            <Image
+              src={typedProfile.avatar_url}
+              alt=""
+              width={80}
+              height={80}
+              className="h-full w-full object-cover"
+            />
+          ) : (
+            <LayoutGrid size={28} />
+          )}
+        </div>
+        <div>
+          <h1 className="font-display text-2xl font-bold">
+            {typedProfile.full_name ?? "Anonymous developer"}
+          </h1>
+          <p className="mt-1 font-mono text-xs text-text-muted">
+            {(apps as App[] | null)?.length ?? 0} published app
+            {(apps as App[] | null)?.length === 1 ? "" : "s"} ·{" "}
+            {totalDownloads.toLocaleString()} total downloads · Member since {memberSince}
+          </p>
+        </div>
+      </div>
+
+      <div className="mt-10">
+        <h2 className="font-display text-lg font-semibold">Published apps</h2>
+        <div className="mt-5">
+          {apps && apps.length > 0 ? (
+            <AnimatedGrid className="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
+              {(apps as App[]).map((app) => (
+                <AppCard key={app.id} app={app} />
+              ))}
+            </AnimatedGrid>
+          ) : (
+            <p className="text-sm text-text-muted">No published apps yet.</p>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
