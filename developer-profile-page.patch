+-- A developer profile page needs the uploader's name/avatar to be visible
+-- to everyone — but only for people who have actually published an app;
+-- someone with a NexApp account who has never published stays private.
+drop policy if exists "Published app authors are publicly viewable" on public.profiles;
+create policy "Published app authors are publicly viewable"
+  on public.profiles for select
+  using (
+    exists (
+      select 1 from public.apps
+      where apps.created_by = profiles.id and apps.status = 'published'
+    )
+  );
+
 drop policy if exists "Users can update their own profile" on public.profiles;
 create policy "Users can update their own profile"
   on public.profiles for update
